{
  "$defs": {
    "Label": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "description": "path to the label artwork (PNG with transparent corners, or JPG)",
          "title": "Image",
          "type": "string"
        },
        "part": {
          "default": "body",
          "description": "the part it wraps",
          "title": "Part",
          "type": "string"
        },
        "from": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "meters up the product where it starts (default: the template's)",
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "meters up where it ends",
          "title": "To"
        },
        "arc": {
          "default": 110,
          "description": "degrees it wraps around the front; 360 all the way round",
          "maximum": 360,
          "minimum": 5,
          "title": "Arc",
          "type": "number"
        }
      },
      "required": [
        "image"
      ],
      "title": "Label",
      "type": "object"
    },
    "PartMaterial": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "body, cap, lid, ...",
          "title": "Name",
          "type": "string"
        },
        "looks_like": {
          "description": "the material in a few words: 'clear glass holding amber liquid', 'brushed aluminium'",
          "title": "Looks Like",
          "type": "string"
        },
        "color": {
          "description": "its surface colour; for glass, the glass's own tint (near white for clear glass, green for green glass), not the liquid's",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Color",
          "type": "string"
        },
        "metallic": {
          "description": "1 for metal, 0 for everything else",
          "maximum": 1,
          "minimum": 0,
          "title": "Metallic",
          "type": "number"
        },
        "roughness": {
          "description": "0.05 polished or glass, 0.3 satin, 0.5 brushed metal, 0.8 matte",
          "maximum": 1,
          "minimum": 0,
          "title": "Roughness",
          "type": "number"
        },
        "transmission": {
          "description": "glass and clear plastic you can see into: 1 for clear glass, 0.9 for tinted glass; 0 for anything opaque (metal, ceramic, opaque plastic, paper)",
          "maximum": 1,
          "minimum": 0,
          "title": "Transmission",
          "type": "number"
        },
        "attenuation_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "see-through parts: the colour of what they hold (amber perfume, green oil), seen through them; null for the rest",
          "title": "Attenuation Color"
        },
        "attenuation_distance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "see-through parts: meters of it after which light has fully taken on attenuation_color: 0.05 deep, 0.08 rich, 0.15 pale (a bottle is 5-10 cm across: under 0.04 it turns nearly black)",
          "title": "Attenuation Distance"
        },
        "clearcoat": {
          "default": 0,
          "description": "a glossy lacquer over it (lacquered caps, coated packaging): 0..1",
          "maximum": 1,
          "minimum": 0,
          "title": "Clearcoat",
          "type": "number"
        }
      },
      "required": [
        "name",
        "looks_like",
        "color",
        "metallic",
        "roughness",
        "transmission"
      ],
      "title": "PartMaterial",
      "type": "object"
    },
    "ProfilePart": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sRGB",
          "title": "Color"
        },
        "opacity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0.02,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "below 1: see-through by fading out (a ghost, not glass; for glass use transmission)",
          "title": "Opacity"
        },
        "metallic": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metallic"
        },
        "roughness": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0 mirror .. 1 matte; glass ~0.05, gold ~0.2",
          "title": "Roughness"
        },
        "transmission": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass and clear liquids: 0.9-1 shows the set through it, bent and tinted (then keep opacity unset)",
          "title": "Transmission"
        },
        "ior": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass: index of refraction, 1.5 glass, 1.33 water",
          "title": "Ior"
        },
        "thickness": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass: meters light travels through it (default the part's width: a solid bottle of liquid)",
          "title": "Thickness"
        },
        "attenuation_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass: the colour light takes on through it, i.e. the liquid's (amber perfume, green oil)",
          "title": "Attenuation Color"
        },
        "attenuation_distance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass: meters of it after which light has fully taken on attenuation_color: 0.05 deep, 0.08 rich, 0.15 pale (under 0.04 a bottle turns nearly black); needed with it",
          "title": "Attenuation Distance"
        },
        "clearcoat": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a glossy lacquer over it (lacquered caps, coated labels), 0..1",
          "title": "Clearcoat"
        },
        "clearcoat_roughness": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clearcoat Roughness"
        },
        "specular": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "strength of a non-metal's reflections (default 1)",
          "title": "Specular"
        },
        "specular_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tint of a non-metal's reflections",
          "title": "Specular Color"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "profile": {
          "description": "[radius, height] in meters, bottom to top",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "minItems": 2,
          "title": "Profile",
          "type": "array"
        }
      },
      "required": [
        "name",
        "profile"
      ],
      "title": "ProfilePart",
      "type": "object"
    },
    "Swatch": {
      "additionalProperties": false,
      "properties": {
        "hex": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Hex",
          "type": "string"
        },
        "role": {
          "description": "where the colour belongs: the product's main colour, a highlight, the label, its text, or the setting",
          "enum": [
            "product",
            "accent",
            "label",
            "text",
            "background"
          ],
          "title": "Role",
          "type": "string"
        },
        "share": {
          "description": "share of the product's pixels with this colour",
          "maximum": 1,
          "minimum": 0,
          "title": "Share",
          "type": "number"
        }
      },
      "required": [
        "hex",
        "role",
        "share"
      ],
      "title": "Swatch",
      "type": "object"
    },
    "Typography": {
      "additionalProperties": false,
      "properties": {
        "font": {
          "description": "the closest of the Studio's fonts to the label's lettering",
          "enum": [
            "serif",
            "sans",
            "sans_bold",
            "condensed",
            "script"
          ],
          "title": "Font",
          "type": "string"
        },
        "case": {
          "enum": [
            "upper",
            "lower",
            "mixed"
          ],
          "title": "Case",
          "type": "string"
        },
        "tracking": {
          "description": "letter spacing in ems, judged from the label",
          "maximum": 1.5,
          "minimum": -0.2,
          "title": "Tracking",
          "type": "number"
        }
      },
      "required": [
        "font",
        "case",
        "tracking"
      ],
      "title": "Typography",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "brand": {
      "description": "the brand name as written on the product",
      "title": "Brand",
      "type": "string"
    },
    "product_name": {
      "default": "",
      "description": "the product's own name, if any",
      "title": "Product Name",
      "type": "string"
    },
    "category": {
      "description": "perfume, beverage can, skincare jar, ...",
      "title": "Category",
      "type": "string"
    },
    "template": {
      "anyOf": [
        {
          "enum": [
            "perfume",
            "bottle",
            "jar",
            "can",
            "dropper"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the Studio template closest to its shape; null when the traced profile is used",
      "title": "Template"
    },
    "height": {
      "description": "real height in meters (estimated from the category)",
      "exclusiveMinimum": 0.005,
      "maximum": 5,
      "title": "Height",
      "type": "number"
    },
    "profile_parts": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ProfilePart"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the shape traced from the photo's silhouette",
      "title": "Profile Parts"
    },
    "materials": {
      "items": {
        "$ref": "#/$defs/PartMaterial"
      },
      "title": "Materials",
      "type": "array"
    },
    "palette": {
      "items": {
        "$ref": "#/$defs/Swatch"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Palette",
      "type": "array"
    },
    "typography": {
      "$ref": "#/$defs/Typography"
    },
    "mood": {
      "description": "a few words: luxurious, warm, minimal, ...",
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Mood",
      "type": "array"
    },
    "do_not": {
      "description": "things every shot must avoid, e.g. 'bright saturated colours'",
      "items": {
        "type": "string"
      },
      "title": "Do Not",
      "type": "array"
    },
    "label": {
      "anyOf": [
        {
          "$ref": "#/$defs/Label"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the label cut from the photo and unrolled, and where it wraps"
    },
    "logo_image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "path to the logo cut from the photo",
      "title": "Logo Image"
    },
    "photos": {
      "description": "the photos it was read from",
      "items": {
        "type": "string"
      },
      "title": "Photos",
      "type": "array"
    }
  },
  "required": [
    "brand",
    "category",
    "height",
    "materials",
    "palette",
    "typography",
    "mood"
  ],
  "title": "BrandProfile",
  "type": "object"
}