{
  "$defs": {
    "Backdrop": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "default": "#0A0A0C",
          "description": "the cyclorama's colour (sRGB)",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Color",
          "type": "string"
        },
        "roughness": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Roughness",
          "type": "number"
        },
        "texture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "an image to cover it with (a path), e.g. from Muse Image",
          "title": "Texture"
        }
      },
      "title": "Backdrop",
      "type": "object"
    },
    "CameraMove": {
      "additionalProperties": false,
      "properties": {
        "move": {
          "description": "static: holds; orbit: circles it; dolly: pushes in/out; crane: rises or drops; truck: slides past; reveal: aim pans onto it; zoom: lens only",
          "enum": [
            "static",
            "orbit",
            "dolly",
            "crane",
            "truck",
            "reveal",
            "zoom"
          ],
          "title": "Move",
          "type": "string"
        },
        "ease": {
          "default": "in_out",
          "enum": [
            "linear",
            "in",
            "out",
            "in_out"
          ],
          "title": "Ease",
          "type": "string"
        },
        "fill": {
          "default": 0.6,
          "description": "share of the frame's height the product fills; 0.45 wide, 0.6 medium, 0.9 close, over 0.97 crops it (a close-up)",
          "maximum": 5,
          "minimum": 0.05,
          "title": "Fill",
          "type": "number"
        },
        "azimuth": {
          "default": 0,
          "description": "degrees around: 0 front, 90 its right, -90 its left",
          "maximum": 360,
          "minimum": -360,
          "title": "Azimuth",
          "type": "number"
        },
        "elevation": {
          "default": 8,
          "description": "degrees above; low angles (2-8) feel heroic",
          "maximum": 85,
          "minimum": -85,
          "title": "Elevation",
          "type": "number"
        },
        "fov_degrees": {
          "default": 30,
          "description": "vertical lens angle; 30 is a product lens",
          "maximum": 179,
          "minimum": 1,
          "title": "Fov Degrees",
          "type": "number"
        },
        "to_azimuth": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "orbit: where it ends",
          "title": "To Azimuth"
        },
        "from_fill": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0.05,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "dolly: framing at the start",
          "title": "From Fill"
        },
        "to_fill": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0.05,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "dolly: framing at the end",
          "title": "To Fill"
        },
        "from_elevation": {
          "anyOf": [
            {
              "maximum": 85,
              "minimum": -85,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "crane: start",
          "title": "From Elevation"
        },
        "to_elevation": {
          "anyOf": [
            {
              "maximum": 85,
              "minimum": -85,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "crane: end",
          "title": "To Elevation"
        },
        "travel": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "truck: meters moved right (negative left)",
          "title": "Travel"
        },
        "from": {
          "anyOf": [
            {
              "enum": [
                "above",
                "below",
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "reveal: where the aim starts",
          "title": "From"
        },
        "from_fov": {
          "anyOf": [
            {
              "maximum": 179,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "zoom: start lens",
          "title": "From Fov"
        },
        "to_fov": {
          "anyOf": [
            {
              "maximum": 179,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "zoom: end lens",
          "title": "To Fov"
        },
        "aperture": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "depth of field, the f-number: the product's front stays sharp and what's behind softens; unset or 0 = all sharp, 2-2.8 a very soft background (close-ups, heroes), 4-5.6 a softened set",
          "title": "Aperture"
        }
      },
      "required": [
        "move"
      ],
      "title": "CameraMove",
      "type": "object"
    },
    "Environment": {
      "additionalProperties": false,
      "properties": {
        "hdri": {
          "default": "hdri/studio_small_09_2k.hdr",
          "description": "HDRI under the Studio's assets, for reflections and ambient light: hdri/studio_small_09_2k.hdr (a photo studio's softboxes: clean highlights on glass and metal) or hdri/citrus_orchard_road_puresky_4k.hdr (an open sky)",
          "title": "Hdri",
          "type": "string"
        },
        "use_ibl": {
          "default": true,
          "description": "light and reflect with the HDRI",
          "title": "Use Ibl",
          "type": "boolean"
        },
        "show_skybox": {
          "default": false,
          "description": "show the HDRI as the background (usually off: the backdrop is the background)",
          "title": "Show Skybox",
          "type": "boolean"
        },
        "ambient_strength": {
          "default": 0.06,
          "description": "0.05 dark and moody, 0.6 bright and airy",
          "maximum": 4,
          "minimum": 0,
          "title": "Ambient Strength",
          "type": "number"
        },
        "exposure": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 16,
          "title": "Exposure",
          "type": "number"
        },
        "bloom": {
          "default": 0.08,
          "description": "glow around bright highlights; 0.03 clean, 0.14 dreamy or neon",
          "maximum": 1,
          "minimum": 0,
          "title": "Bloom",
          "type": "number"
        },
        "tonemap": {
          "default": "agx",
          "description": "agx: soft filmic; aces: contrasty; neutral: colours as authored (bright, clean looks)",
          "enum": [
            "agx",
            "aces",
            "neutral"
          ],
          "title": "Tonemap",
          "type": "string"
        },
        "ssao": {
          "default": true,
          "title": "Ssao",
          "type": "boolean"
        }
      },
      "title": "Environment",
      "type": "object"
    },
    "Key": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        },
        "ease": {
          "default": "linear",
          "enum": [
            "linear",
            "in",
            "out",
            "in_out",
            "step"
          ],
          "title": "Ease",
          "type": "string"
        }
      },
      "required": [
        "t",
        "value"
      ],
      "title": "Key",
      "type": "object"
    },
    "Label": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "description": "path to the label artwork (PNG with transparent corners, or JPG)",
          "title": "Image",
          "type": "string"
        },
        "part": {
          "default": "body",
          "description": "the part it wraps",
          "title": "Part",
          "type": "string"
        },
        "from": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "meters up the product where it starts (default: the template's)",
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "meters up where it ends",
          "title": "To"
        },
        "arc": {
          "default": 110,
          "description": "degrees it wraps around the front; 360 all the way round",
          "maximum": 360,
          "minimum": 5,
          "title": "Arc",
          "type": "number"
        }
      },
      "required": [
        "image"
      ],
      "title": "Label",
      "type": "object"
    },
    "Lighting": {
      "additionalProperties": false,
      "properties": {
        "preset": {
          "description": "rim_dark: luxury, moody; high_key: clean, bright (light backdrop); top_soft: natural, skylight; split: dramatic; neon_dual: bold, energetic; three_point: neutral",
          "enum": [
            "three_point",
            "rim_dark",
            "high_key",
            "top_soft",
            "split",
            "neon_dual"
          ],
          "title": "Preset",
          "type": "string"
        },
        "intensity": {
          "default": 1.0,
          "description": "times the preset's brightness",
          "maximum": 20,
          "minimum": 0,
          "title": "Intensity",
          "type": "number"
        },
        "turn": {
          "default": 0.0,
          "description": "degrees to turn the whole setup around the product",
          "maximum": 360,
          "minimum": -360,
          "title": "Turn",
          "type": "number"
        },
        "warmth": {
          "default": 0.0,
          "description": "-1 cooler .. 1 warmer",
          "maximum": 1,
          "minimum": -1,
          "title": "Warmth",
          "type": "number"
        },
        "fade_in": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "seconds over which every light rises from dark at the start (a reveal)",
          "title": "Fade In"
        },
        "glow": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a soft pool of light on the wall behind the product: glass lights up in it in the colour of what it holds (a backlit bottle); 1 subtle, 2-3 strong; for glass on a dark set",
          "title": "Glow"
        },
        "glow_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the glow's colour (default warm)",
          "title": "Glow Color"
        }
      },
      "required": [
        "preset"
      ],
      "title": "Lighting",
      "type": "object"
    },
    "Look": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "background": {
          "default": [
            0.004,
            0.004,
            0.006
          ],
          "description": "linear RGB where nothing is drawn (behind the backdrop's edges)",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Background",
          "type": "array"
        },
        "backdrop": {
          "$ref": "#/$defs/Backdrop"
        },
        "pedestal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pedestal"
            },
            {
              "type": "null"
            }
          ],
          "description": "null: the product stands on the floor"
        },
        "lighting": {
          "$ref": "#/$defs/Lighting"
        }
      },
      "required": [
        "lighting"
      ],
      "title": "Look",
      "type": "object"
    },
    "PartLook": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sRGB",
          "title": "Color"
        },
        "opacity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0.02,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "below 1: see-through by fading out (a ghost, not glass; for glass use transmission)",
          "title": "Opacity"
        },
        "metallic": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metallic"
        },
        "roughness": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0 mirror .. 1 matte; glass ~0.05, gold ~0.2",
          "title": "Roughness"
        },
        "transmission": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass and clear liquids: 0.9-1 shows the set through it, bent and tinted (then keep opacity unset)",
          "title": "Transmission"
        },
        "ior": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass: index of refraction, 1.5 glass, 1.33 water",
          "title": "Ior"
        },
        "thickness": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass: meters light travels through it (default the part's width: a solid bottle of liquid)",
          "title": "Thickness"
        },
        "attenuation_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass: the colour light takes on through it, i.e. the liquid's (amber perfume, green oil)",
          "title": "Attenuation Color"
        },
        "attenuation_distance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass: meters of it after which light has fully taken on attenuation_color: 0.05 deep, 0.08 rich, 0.15 pale (under 0.04 a bottle turns nearly black); needed with it",
          "title": "Attenuation Distance"
        },
        "clearcoat": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a glossy lacquer over it (lacquered caps, coated labels), 0..1",
          "title": "Clearcoat"
        },
        "clearcoat_roughness": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clearcoat Roughness"
        },
        "specular": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "strength of a non-metal's reflections (default 1)",
          "title": "Specular"
        },
        "specular_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tint of a non-metal's reflections",
          "title": "Specular Color"
        }
      },
      "title": "PartLook",
      "type": "object"
    },
    "Pedestal": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "default": 0.32,
          "description": "diameter, meters; a little wider than the product",
          "exclusiveMinimum": 0.02,
          "maximum": 3,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "default": 0.2,
          "description": "meters; the product stands on it",
          "exclusiveMinimum": 0.01,
          "maximum": 2,
          "title": "Height",
          "type": "number"
        },
        "color": {
          "default": "#0E0E10",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Color",
          "type": "string"
        },
        "roughness": {
          "default": 0.85,
          "description": "keep high (0.8+) under rim lights, or its top glares",
          "maximum": 1,
          "minimum": 0,
          "title": "Roughness",
          "type": "number"
        }
      },
      "title": "Pedestal",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "template": {
          "anyOf": [
            {
              "enum": [
                "perfume",
                "bottle",
                "jar",
                "can",
                "dropper"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the shape; null with `profile_parts` for a shape traced from a photo",
          "title": "Template"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.005,
              "maximum": 5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "meters (templates have a typical size)",
          "title": "Height"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.005,
              "maximum": 5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "meters across at the widest",
          "title": "Width"
        },
        "parts": {
          "additionalProperties": {
            "$ref": "#/$defs/PartLook"
          },
          "description": "template parts' looks by name: body, cap, lid, collar, bulb",
          "title": "Parts",
          "type": "object"
        },
        "profile_parts": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ProfilePart"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the shape as profiles (from the brand analyst), instead of a template",
          "title": "Profile Parts"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Product",
      "type": "object"
    },
    "ProfilePart": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sRGB",
          "title": "Color"
        },
        "opacity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0.02,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "below 1: see-through by fading out (a ghost, not glass; for glass use transmission)",
          "title": "Opacity"
        },
        "metallic": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metallic"
        },
        "roughness": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0 mirror .. 1 matte; glass ~0.05, gold ~0.2",
          "title": "Roughness"
        },
        "transmission": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass and clear liquids: 0.9-1 shows the set through it, bent and tinted (then keep opacity unset)",
          "title": "Transmission"
        },
        "ior": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass: index of refraction, 1.5 glass, 1.33 water",
          "title": "Ior"
        },
        "thickness": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass: meters light travels through it (default the part's width: a solid bottle of liquid)",
          "title": "Thickness"
        },
        "attenuation_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glass: the colour light takes on through it, i.e. the liquid's (amber perfume, green oil)",
          "title": "Attenuation Color"
        },
        "attenuation_distance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
